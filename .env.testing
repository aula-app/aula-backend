# this file is
# - sourced implicitly by manual runs,
#   e.g. when VSCode runs vendor/bin/pest
# - referenced explicitly in docker-compose.test.yml
# the latter can easily&locally override entries, notably the HOST and PORT

APP_KEY=base64:eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg=

DB_CONNECTION=mariadb
