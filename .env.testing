# (using docker-compose.yml, not .test.yml)
DB_PORT=3307
DB_DATABASE=aula_database
DB_USERNAME=aula_user
DB_PASSWORD=example
CENTRAL_DB_NAME=aula_database
CENTRAL_DB_USER=aula_user
